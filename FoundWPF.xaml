<Window x:Class="TNovPiles.FoundWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovPiles"
        mc:Ignorable="d"
        Width="360"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:FoundViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СВАИ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Text="Выберите сценарий работы:"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <Button Content="Ручной нумератор"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="foundnumButton"
                    Command="{Binding Path=scenario1}"
                    Click="acceptButton_Click"
                    Margin="0,0,0,8"/>
            <Button Content="Автонумерация"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="foundnumautoButton"
                    Command="{Binding Path=scenario2}"
                    Click="acceptButton_Click"
                    Margin="0,0,0,8"/>
            <Button Content="Убрать пробелы/дубли"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="foundnumpurge"
                    Command="{Binding Path=scenario3}"
                    Click="acceptButton_Click"
                    Margin="0,0,0,8"/>
            <Button Content="Номера для спеки"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="foundnumspecButton"
                    Command="{Binding Path=scenario4}"
                    Click="acceptButton_Click"
                    Margin="0,0,0,8"/>
            <Button Content="Заполнить отметки"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="foundotmButton"
                    Command="{Binding Path=scenario6}"
                    Click="acceptButton_Click"
                    Margin="0,0,0,8"/>
            <Button Content="Вырезать фундамент"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="foundcutButton"
                    Command="{Binding Path=scenario5}"
                    Click="acceptButton_Click"
                    Margin="0"/>
        </StackPanel>
    </Border>
</Window>
