<Window x:Class="TNovPiles.FoundAutoNumWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovPiles"
        mc:Ignorable="d"
        Width="400"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:FoundAutoNumViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="АВТОНУМЕРАЦИЯ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Параметр:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding parameterName}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Порядок нумерации:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding rules}"
                          SelectedItem="{Binding Path=rule, Mode=TwoWay}"
                          SelectedIndex="0"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="text1"
                           Text="Начальное значение:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Name="textBox1"
                         Text="{Binding startvalue}"
                         Style="{StaticResource DarkTextBoxStyle}" Height="36"
                         TextAlignment="Center"/>
            </Grid>

            <ToggleButton x:Name="checkBox1"
                          Style="{StaticResource CardToggleStyle}"
                         Margin="0 0 0 8"
                          IsChecked="{Binding divide}">
                <TextBlock Text="Разделять по отметкам свай" 
                           Style="{StaticResource CardTitleStyle}"
                           TextWrapping="Wrap"/>
            </ToggleButton>

            

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Отмена"
                        x:Name="escButton"
                        Style="{StaticResource CloseButtonStyle}"
                        IsCancel="True"
                        Click="escButton_Click" Margin="0,44,0,0"/>
                <StackPanel Grid.Column="2"><Button 
                        Content="Выбор и запуск"
                        x:Name="selectButton"
                        Style="{StaticResource RunButtonStyle}"
                        Margin="0"
                        Command="{Binding Path=scenario2}"
                        Click="acceptButton_Click"/>
                <Button  Content="Запуск для всех" 
        Style="{StaticResource RunButtonStyle}"
        x:Name="allButton"
        Command="{Binding Path=scenario1}"
        Click="acceptButton_Click"
        Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
